<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ReactionTimeMeasurementApp</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Minden koordináta (inger, fotodióda, tekintet) fizikai képpontban értendő, bármelyik monitoron. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- A mérési fájlok metaadataiba kerül (AppVersion). -->
    <Version>1.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="9.0.0" />
    <Reference Include="Tobii.Research">
      <HintPath>SDK\Tobii.Research.x64.2.1.0.1\lib\netstandard2.0\Tobii.Research.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="SDK\Tobii.Research.x64.2.1.0.1\runtimes\win-x64\native\tobii_pro.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="SDK\Tobii.Research.x64.2.1.0.1\runtimes\win-x64\native\tobii_firmware_upgrade.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Images\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
