<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ReactionTimeMeasurementApp</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Minden koordináta (inger, fotodióda, tekintet) fizikai képpontban értendő, bármelyik monitoron. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- A mérési fájlok metaadataiba kerül (AppVersion). -->
    <Version>1.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="9.0.0" />
    <!-- A Tobii Pro SDK a nuget.org-ról jön (a csomag a natív tobii_pro.dll-t is az exe mellé másolja).
         A csomag licence (requireLicenseAcceptance) csak nem kereskedelmi kutatási célú használatot enged. -->
    <PackageReference Include="Tobii.Research.x64" Version="2.1.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Images\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
